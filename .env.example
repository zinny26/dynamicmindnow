# Postgres connection string (Neon, Supabase, Render, Railway, RDS, local postgres...)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared webhook key. The external publisher must send this exact value
# in the "X-API-Key" header of POST /api/articles-webhook.
GRANDRANKER_SECRET=

# Public origin of the site. Used for canonical URLs, og:url and sitemap.xml.
SITE_URL=https://adhdanxietydepressionhelp.org

# Port the HTTP server listens on (most hosts set this automatically).
PORT=3000
